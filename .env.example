# ===================================
# ADAPTAI - Configuração do Backend
# ===================================

# IMPORTANTE: Copie este arquivo para .env e preencha com suas credenciais reais
# cp .env.example .env

# ============================
# APLICAÇÃO
# ============================
APP_NAME=AdaptAI
VERSION=2.1
ENVIRONMENT=development

# ============================
# BANCO DE DADOS MYSQL
# ============================
# Para desenvolvimento local, use seu MySQL local
# Para produção, use suas credenciais do DBaaS
#
# IMPORTANTE: os nomes abaixo (MYSQL_*) são os que app/core/config.py lê de
# fato. Alternativamente, defina DATABASE_URL diretamente (tem prioridade).

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=seu_usuario
MYSQL_PASSWORD=sua_senha
MYSQL_DATABASE=adaptai

# Exemplo produção (Railway/DBaaS):
# MYSQL_HOST=seu_host.mysql.dbaas.com.br
# MYSQL_PORT=3306
# MYSQL_USER=seu_usuario
# MYSQL_PASSWORD=sua_senha_segura
# MYSQL_DATABASE=adaptai

# ============================
# JWT / SEGURANÇA
# ============================
# IMPORTANTE: Gere uma chave secreta forte!
# Você pode usar: openssl rand -hex 32

SECRET_KEY=sua_chave_secreta_aqui_minimo_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================
# LLM (DeepSeek, via API compativel com Anthropic)
# ============================
# Obtenha sua API key em: https://platform.deepseek.com/

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-v4-pro
# LLM_FAST_MODEL=deepseek-flash

# ============================
# CORS (Frontend)
# ============================
# URLs permitidas para acesso ao backend
# Separe múltiplas URLs com vírgula

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://seu-frontend.vercel.app

# ============================
# STORAGE / UPLOADS
# ============================
# Caminho para storage de arquivos

STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=10

# ============================
# CONFIGURAÇÕES OPCIONAIS
# ============================

# Debug mode (apenas development)
DEBUG=True

# Timezone
TIMEZONE=America/Sao_Paulo

# Logging
LOG_LEVEL=INFO

# ============================
# PAGAMENTO (ASAAS)
# ============================
# Gere a API Key no painel Asaas: Integracoes > Chaves de API
# Sandbox (testes) e Producao usam chaves diferentes.
#   - Chaves de Sandbox comecam com $aact_hmlg_
#   - Chaves de Producao comecam com $aact_prod_
# Deixe ASAAS_API_KEY vazio para desativar a cobranca (o checkout ainda cria o trial).

ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token de seguranca do webhook: defina o MESMO valor aqui e no painel Asaas
# (Integracoes > Webhooks > token de autenticacao). Enviado no header 'asaas-access-token'.
ASAAS_WEBHOOK_TOKEN=

# Webhook a cadastrar no painel Asaas (eventos de cobranca):
#   <URL_DO_BACKEND>/api/v1/checkout/webhook/asaas
